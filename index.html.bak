<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>فندق ومطعم حرض الدولي</title>
<style>
:root{--bg:#f5efe8;--card:rgba(255,255,255,.72);--bd:rgba(74,37,17,.12);--tx:#2a1408;--sub:#7a5a46;--mocha:#4a2511;--mocha2:#8b4513;--amb:#d97706;--nav:rgba(245,239,232,.72);--sh:rgba(40,20,5,.35);color-scheme:light;
--p1:#b45309;--p2:#78350f;--p3:#fcd9a0}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#1a0e07;--card:rgba(60,34,20,.62);--bd:rgba(255,220,180,.14);--tx:#f6e9dc;--sub:#c9a98f;--nav:rgba(26,14,7,.72);--sh:rgba(0,0,0,.6);color-scheme:dark;--p1:#fbbf24;--p2:#7c2d12;--p3:#fff3c4}}
:root[data-theme="dark"]{--bg:#1a0e07;--card:rgba(60,34,20,.62);--bd:rgba(255,220,180,.14);--tx:#f6e9dc;--sub:#c9a98f;--nav:rgba(26,14,7,.72);--sh:rgba(0,0,0,.6);color-scheme:dark;--p1:#fbbf24;--p2:#7c2d12;--p3:#fff3c4}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html{scroll-padding-top:calc(env(safe-area-inset-top,0px) + 60px)}
body{margin:0;background:var(--bg);color:var(--tx);font-family:-apple-system,"SF Pro Arabic","Segoe UI",Tahoma,"Noto Naskh Arabic",sans-serif;padding-bottom:calc(env(safe-area-inset-bottom,0px) + 40px);min-height:100vh;background-image:radial-gradient(900px 420px at 50% -80px,rgba(217,119,6,.22),transparent)}
button,input,select,textarea{font:inherit;color:inherit}
button{cursor:pointer;border:0;background:none}
#nav{position:fixed;top:0;inset-inline:0;z-index:30;padding:calc(env(safe-area-inset-top,0px) + 8px) 12px 8px;background:var(--nav);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border-bottom:1px solid var(--bd);display:flex;justify-content:space-between;align-items:center;direction:ltr}
.cur{display:flex;background:var(--bd);border-radius:999px;padding:2px}
.cur button{padding:6px 9px;border-radius:999px;font-size:12px;font-weight:600;color:var(--sub);transition:.3s cubic-bezier(.32,.72,0,1)}
.cur button.on{background:var(--amb);color:#fff;box-shadow:0 2px 8px rgba(217,119,6,.5)}
.tg{width:62px;height:32px;border-radius:999px;background:var(--bd);position:relative;padding:0}
.tg span{position:absolute;top:2px;left:2px;width:28px;height:28px;border-radius:50%;background:#fff;display:grid;place-items:center;font-size:15px;box-shadow:0 2px 6px rgba(0,0,0,.3);transition:transform .4s cubic-bezier(.32,.72,0,1)}
[data-theme="dark"] .tg span{transform:translateX(30px);background:#3a2112}
.mb{font-size:24px;width:38px;height:38px;border-radius:12px;background:var(--bd)}
main{max-width:720px;margin:0 auto;padding:calc(env(safe-area-inset-top,0px) + 62px) 16px 0}
#ptr{text-align:center;height:0;overflow:hidden;color:var(--sub);font-size:13px;transition:height .3s}
.hero{text-align:center;padding:14px 0 6px;transition:transform .3s cubic-bezier(.32,.72,0,1)}
.logo{width:190px;height:190px;border-radius:50%;cursor:pointer;filter:drop-shadow(0 14px 22px var(--sh));position:relative}
.lw{display:inline-block;position:relative}
.lw i{position:absolute;top:8%;inset-inline-end:2%;font-style:normal;font-size:30px;opacity:0;pointer-events:none}
.lw.go .logo{animation:pop 1.1s cubic-bezier(.32,.72,0,1)}
.lw.go i{animation:sp 1.1s ease .45s}
@keyframes pop{0%{transform:scale(.6) rotate(0)}30%{transform:scale(1.14) rotate(-7deg)}50%{transform:scale(1.08,.96) rotate(5deg)}65%{transform:scale(1.1,1) rotate(-4deg)}100%{transform:scale(1) rotate(0)}}
@keyframes sp{0%{opacity:0;transform:scale(.3)}40%{opacity:1;transform:scale(1.3) rotate(15deg)}100%{opacity:0;transform:scale(.8)}}
h1{margin:8px 0 2px;font-size:26px;letter-spacing:-.3px}
.tag{color:var(--sub);font-size:14px;margin:0}
.glass{background:var(--card);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border:1px solid var(--bd);border-radius:22px;box-shadow:0 8px 24px -12px var(--sh)}
.promo{margin:16px 0;padding:0;overflow:hidden;background:linear-gradient(135deg,var(--mocha),var(--mocha2));color:#fff;border:0}
.promo img,.promo video{width:100%;max-height:200px;object-fit:cover;display:block}
.promo p{margin:0;padding:16px 18px;font-weight:700;font-size:16px;line-height:1.7}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.tile{padding:18px 12px;text-align:center;font-weight:700;font-size:15px;transition:transform .35s cubic-bezier(.32,.72,0,1)}
.tile:active{transform:scale(.95)}
.tile b{display:block;font-size:34px;margin-bottom:6px}
.tile.big{grid-column:1/-1;background:linear-gradient(135deg,var(--mocha2),var(--amb));color:#fff;border:0}
.p3d{font-weight:900;font-size:19px;color:var(--p1);letter-spacing:.5px;white-space:nowrap;text-shadow:0 1px 0 var(--p2),0 2px 0 var(--p2),0 3px 0 var(--p2),0 4px 2px rgba(0,0,0,.35),0 -1px 0 var(--p3)}
#ov{position:fixed;inset:0;z-index:40;background:rgba(20,8,0,.45);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);opacity:0;pointer-events:none;transition:opacity .35s}
#ov.on{opacity:1;pointer-events:auto}
#sh{position:fixed;z-index:41;bottom:0;inset-inline:0;margin:0 auto;max-width:720px;height:88vh;transform:translateY(105%);transition:transform .5s cubic-bezier(.32,.72,0,1);background:var(--bg);border-radius:24px 24px 0 0;display:flex;flex-direction:column;box-shadow:0 -10px 40px var(--sh);border:1px solid var(--bd)}
#sh.on{transform:none}
.grab{width:40px;height:5px;border-radius:9px;background:var(--bd);margin:8px auto 0}
.shh{display:flex;justify-content:space-between;align-items:center;padding:8px 18px}
.shh h2{margin:0;font-size:20px}
.x{width:32px;height:32px;border-radius:50%;background:var(--bd);font-size:14px}
#sb{overflow-y:auto;padding:4px 16px calc(env(safe-area-inset-bottom,0px) + 90px);flex:1;overscroll-behavior:contain}
.chips{display:flex;gap:8px;overflow-x:auto;scroll-snap-type:x mandatory;padding:4px 0 12px;scrollbar-width:none}
.chips button{scroll-snap-align:start;flex:none;padding:9px 18px;border-radius:999px;background:var(--card);border:1px solid var(--bd);font-weight:600}
.chips button.on{background:var(--mocha2);color:#fff;border-color:transparent}
.items{display:grid;grid-template-columns:repeat(auto-fill,minmax(155px,1fr));gap:12px}
.it{overflow:hidden;display:flex;flex-direction:column}
.th{height:110px;background:linear-gradient(135deg,var(--mocha),var(--mocha2));display:grid;place-items:center;font-size:48px}
.th img{width:100%;height:100%;object-fit:cover}
.it .bd{padding:10px 12px 12px;display:flex;flex-direction:column;gap:5px;flex:1}
.it h3{margin:0;font-size:15px}
.it small{color:var(--sub);line-height:1.5;flex:1}
.row{display:flex;justify-content:space-between;align-items:center;gap:6px}
.add{background:var(--amb);color:#fff;border-radius:999px;width:34px;height:34px;font-size:20px;font-weight:700}
.rooms{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:12px}
.rooms .th{height:150px}
#wa{position:fixed;z-index:50;bottom:calc(env(safe-area-inset-bottom,0px) + 18px);left:50%;transform:translate(-50%,200%);transition:transform .55s cubic-bezier(.32,.72,0,1);background:#25d366;color:#fff;padding:14px 22px;border-radius:999px;font-weight:800;text-decoration:none;box-shadow:0 10px 26px rgba(37,211,102,.5);white-space:nowrap}
#wa.on{transform:translate(-50%,0)}
.f{display:flex;flex-direction:column;gap:10px}
.f input,.f select,.f textarea{width:100%;padding:12px 14px;border-radius:14px;border:1px solid var(--bd);background:var(--card);outline:0}
.f input:focus,.f select:focus,.f textarea:focus{border-color:var(--amb)}
.btn{padding:13px 18px;border-radius:14px;background:var(--amb);color:#fff;font-weight:700;text-align:center;text-decoration:none;display:block}
.btn.g{background:#25d366}.btn.b{background:#0a84ff}.btn.r{background:#ff3b30}.btn.s{background:var(--bd);color:var(--tx)}
.ci{display:flex;align-items:center;gap:10px;padding:10px 0;border-bottom:1px solid var(--bd)}
.ci div:first-child{flex:1}
.q{display:flex;align-items:center;gap:8px}.q button{width:28px;height:28px;border-radius:50%;background:var(--bd);font-weight:700}
.tot{display:flex;justify-content:space-between;align-items:center;padding:14px 0}
table{width:100%;border-collapse:collapse;font-size:13px}
td,th{padding:8px 4px;border-bottom:1px solid var(--bd);text-align:start}
td img{width:38px;height:38px;border-radius:8px;object-fit:cover;vertical-align:middle}
.sm{padding:6px 10px;border-radius:10px;font-size:12px;font-weight:700;background:var(--bd)}
.sm.r{background:#ff3b30;color:#fff}
#dr{position:fixed;z-index:60;top:0;bottom:0;right:0;width:min(82vw,320px);transform:translateX(105%);transition:transform .5s cubic-bezier(.32,.72,0,1);background:var(--nav);backdrop-filter:blur(30px);-webkit-backdrop-filter:blur(30px);border-inline-start:1px solid var(--bd);padding:calc(env(safe-area-inset-top,0px) + 20px) 16px calc(env(safe-area-inset-bottom,0px) + 16px);display:flex;flex-direction:column;gap:8px;box-shadow:-10px 0 40px var(--sh)}
#dr.on{transform:none}
#dr .d{padding:14px;border-radius:14px;background:var(--card);border:1px solid var(--bd);text-align:start;font-weight:600}
#dr .sp{flex:1}
.dev{background:#25d366;color:#fff;padding:14px;border-radius:999px;text-align:center;text-decoration:none;font-weight:800;font-size:13px;line-height:1.5}
#toast{position:fixed;z-index:70;top:calc(env(safe-area-inset-top,0px) + 64px);left:50%;transform:translate(-50%,-200%);background:var(--mocha);color:#fff;padding:10px 18px;border-radius:999px;transition:transform .5s cubic-bezier(.32,.72,0,1);font-size:14px}
#toast.on{transform:translate(-50%,0)}
.empty{text-align:center;color:var(--sub);padding:40px 0}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
</head>
<body>
<div id="nav">
 <div class="cur" id="cur"></div>
 <button class="tg" id="tg" aria-label="theme"><span>☀️</span></button>
 <button class="mb" id="mb" aria-label="menu">☰</button>
</div>
<main>
 <div id="ptr">↓ اسحب للأسفل للتحديث</div>
 <section class="hero" id="hero">
  <div class="lw" id="lw"><img class="logo" id="logo" src="data:image/png;base64," alt="التميز عنوان"><i>✨</i></div>
  <h1>فندق ومطعم حرض الدولي</h1>
  <p class="tag">التميز .. عنوان</p>
 </section>
 <div class="glass promo" id="promo"></div>
 <div class="grid">
  <button class="glass tile big" data-s="menu"><b>🍽️</b>قائمة الطعام</button>
  <button class="glass tile" data-s="rooms"><b>🏨</b>غرف الفندق</button>
  <button class="glass tile" data-s="cart"><b>🛒</b>سلة الطلبات <span id="cc"></span></button>
  <button class="glass tile" data-s="contact"><b>📞</b>اتصل بنا</button>
  <button class="glass tile" data-s="complaint"><b>💬</b>الشكاوى والملاحظات</button>
  <button class="glass tile" data-s="about" style="grid-column:1/-1"><b>👨‍🍳</b>من نحن</button>
 </div>
</main>
<div id="ov"></div>
<div id="sh"><div class="grab"></div><div class="shh"><h2 id="st"></h2><button class="x" id="sx">✕</button></div><div id="sb"></div></div>
<a id="wa" href="https://wa.me/967773041398" target="_blank" rel="noopener">🏨 إحجز غرفتك الآن عبر الواتساب</a>
<aside id="dr">
 <button class="d" data-s="menu">🍽️ قائمة الطعام</button>
 <button class="d" data-s="rooms">🏨 غرف الفندق</button>
 <button class="d" data-s="cart">🛒 سلة الطلبات</button>
 <button class="d" data-s="contact">📞 اتصل بنا</button>
 <button class="d" data-s="complaint">💬 الشكاوى</button>
 <button class="d" data-s="about">ℹ️ من نحن</button>
 <button class="d" data-s="admin">🔐 لوحة الإدارة</button>
 <div class="sp"></div>
 <a class="dev" href="https://wa.me/967780788664" target="_blank" rel="noopener">👨‍💻 تم إنشاء هذا الموقع بواسطة المبرمج: محفوظ الحطامي</a>
</aside>
<div id="toast"></div>
<script>
const $=s=>document.querySelector(s);
const esc=t=>String(t??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const CATS=['الأكثر طلباً','مأكولات بحرية','عصائر','حلويات'];
const RATE={YER:1,SAR:140,USD:530},SYM={YER:'ر.ي',SAR:'ر.س',USD:'$'},FLAG={YER:'🇾🇪',SAR:'🇸🇦',USD:'🇺🇸'};
const DEF={dishes:[
{id:1,n:'مندي دجاج',d:'أرز بسمتي مع دجاج مدخن على الفحم',p:4500,c:0,e:'🍗'},
{id:2,n:'مظبي لحم',d:'لحم طري على الحجر الساخن',p:7000,c:0,e:'🥩'},
{id:3,n:'سمك مقلي',d:'سمك طازج مع أرز وصوص حار',p:5500,c:1,e:'🐟'},
{id:4,n:'روبيان مشوي',d:'جمبري مشوي بالثوم والليمون',p:9000,c:1,e:'🦐'},
{id:5,n:'عصير مانجو',d:'مانجو طبيعي مثلج',p:1500,c:2,e:'🥭'},
{id:6,n:'عصير برتقال',d:'برتقال طازج بدون سكر',p:1200,c:2,e:'🍊'},
{id:7,n:'بنت الصحن',d:'عسل وسمن بلدي',p:3000,c:3,e:'🍯'},
{id:8,n:'كنافة بالجبن',d:'ساخنة مع قطر',p:2500,c:3,e:'🍰'}],
rooms:[
{id:1,n:'غرفة مفردة',d:'سرير مفرد، تكييف، إنترنت مجاني',p:12000,e:'🛏️'},
{id:2,n:'غرفة مزدوجة',d:'سريران، إطلالة، إفطار مجاني',p:18000,e:'🛌'},
{id:3,n:'جناح ملكي',d:'صالة وغرفة نوم ومطبخ صغير',p:35000,e:'👑'}],
banner:{t:'مرحباً بكم في حرض — خدمة على مدار 24 ساعة',m:'',v:0},jeeb:'773041398',wallet:'كريمي / ون كاش / محفظتي'};
let S;try{S=JSON.parse(localStorage.getItem('harad')||'null')}catch(e){}
S=Object.assign({},JSON.parse(JSON.stringify(DEF)),S||{});
let cur=S.cur||'YER',cart={},sheet='',cat=0,adm=false,tab='dishes',ed=null,tmp='';
function save(){try{localStorage.setItem('harad',JSON.stringify(Object.assign(S,{cur})))}catch(e){toast('⚠️ مساحة التخزين ممتلئة')}}
function toast(m){const t=$('#toast');t.textContent=m;t.classList.add('on');clearTimeout(toast.k);toast.k=setTimeout(()=>t.classList.remove('on'),2200)}
function fmt(y){const v=y/RATE[cur];return (cur==='YER'?Math.round(v).toLocaleString('en'):v.toLocaleString('en',{maximumFractionDigits:2}))+' '+SYM[cur]}
const P=y=>`<span class="p3d">${fmt(y)}</span>`;
/* theme */
function theme(t){document.documentElement.dataset.theme=t;$('#tg span').textContent=t==='dark'?'🌙':'☀️';try{localStorage.setItem('hth',t)}catch(e){}}
theme((()=>{try{return localStorage.getItem('hth')}catch(e){}})()||(matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light'));
$('#tg').onclick=()=>theme(document.documentElement.dataset.theme==='dark'?'light':'dark');
/* currency */
function curBar(){$('#cur').innerHTML=Object.keys(RATE).map(k=>`<button class="${k===cur?'on':''}" data-c="${k}">${FLAG[k]} ${k}</button>`).join('')}
$('#cur').onclick=e=>{const c=e.target.closest('[data-c]');if(!c)return;cur=c.dataset.c;save();curBar();if(sheet)render()};
/* logo + pull to refresh */
function wink(){const l=$('#lw');l.classList.remove('go');void l.offsetWidth;l.classList.add('go')}
$('#logo').onclick=wink;
let y0=null;
addEventListener('touchstart',e=>{y0=(scrollY<=0&&!sheet)?e.touches[0].clientY:null},{passive:true});
addEventListener('touchmove',e=>{if(y0===null)return;const d=e.touches[0].clientY-y0;if(d>0){const m=Math.min(d/2.5,50);$('#ptr').style.height=m+'px';$('#hero').style.transform=`translateY(${m/3}px)`;$('#ptr').textContent=d>90?'↑ اترك للتحديث':'↓ اسحب للأسفل للتحديث'}},{passive:true});
addEventListener('touchend',e=>{if(y0===null)return;const d=e.changedTouches[0].clientY-y0;$('#ptr').style.height=0;$('#hero').style.transform='';if(d>90){wink();paint()}y0=null});
/* home */
function paint(){const b=S.banner;$('#promo').innerHTML=(b.m?(b.v?`<video src="${b.m}" autoplay muted loop playsinline></video>`:`<img src="${b.m}" alt="">`):'')+`<p>${esc(b.t)}</p>`;const n=Object.values(cart).reduce((a,b)=>a+b,0);$('#cc').textContent=n?`(${n})`:''}
/* sheets */
const TITLE={menu:'🍽️ قائمة الطعام',rooms:'🏨 غرف الفندق',cart:'🛒 سلة الطلبات',contact:'📞 اتصل بنا',complaint:'💬 الشكاوى والملاحظات',about:'👨‍🍳 من نحن',admin:'🔐 لوحة الإدارة'};
function openS(s){sheet=s;closeDr();$('#st').textContent=TITLE[s];render();$('#ov').classList.add('on');$('#sh').classList.add('on');$('#wa').classList.toggle('on',s==='rooms')}
function closeS(){sheet='';$('#ov').classList.remove('on');$('#sh').classList.remove('on');$('#wa').classList.remove('on');paint()}
function render(){const sc=$('#sb').scrollTop;$('#sb').innerHTML=V[sheet]();$('#sb').scrollTop=sc}
function closeDr(){$('#dr').classList.remove('on')}
$('#ov').onclick=()=>{closeS();closeDr()};$('#sx').onclick=closeS;
$('#mb').onclick=()=>$('#dr').classList.toggle('on');
document.addEventListener('click',e=>{const t=e.target.closest('[data-s]');if(t)openS(t.dataset.s)});
const thumb=(o,h)=>`<div class="th">${o.i?`<img src="${o.i}" alt="">`:o.e||'🍽️'}</div>`;
const V={
menu(){const l=S.dishes.filter(d=>d.c==cat);return `<div class="chips">${CATS.map((c,i)=>`<button class="${i==cat?'on':''}" onclick="cat=${i};render()">${c}</button>`).join('')}</div>
<div class="items">${l.map(d=>`<div class="glass it">${thumb(d)}<div class="bd"><h3>${esc(d.n)}</h3><small>${esc(d.d)}</small><div class="row">${P(d.p)}<button class="add" onclick="add(${d.id})">+</button></div></div></div>`).join('')||'<div class="empty">لا توجد أصناف في هذا القسم</div>'}</div>`},
rooms(){return `<div class="rooms">${S.rooms.map(r=>`<div class="glass it">${thumb(r)}<div class="bd"><h3>${esc(r.n)}</h3><small>${esc(r.d)}</small><div class="row">${P(r.p)}<small>/ الليلة</small></div></div></div>`).join('')||'<div class="empty">لا توجد غرف حالياً</div>'}</div>`},
cart(){const ids=Object.keys(cart);if(!ids.length)return '<div class="empty">السلة فارغة — أضف أصنافاً من قائمة الطعام</div>';
let tot=0;const rows=ids.map(id=>{const d=S.dishes.find(x=>x.id==id);if(!d)return '';tot+=d.p*cart[id];return `<div class="ci"><div><b>${esc(d.n)}</b><br>${P(d.p*cart[id])}</div><div class="q"><button onclick="qty(${id},1)">+</button><b>${cart[id]}</b><button onclick="qty(${id},-1)">−</button></div></div>`}).join('');
return rows+`<div class="tot"><b>الإجمالي</b>${P(tot)}</div><div class="f"><input id="cn" placeholder="الاسم" autocomplete="name"><input id="cp" type="tel" placeholder="رقم الهاتف" autocomplete="tel"><input id="ca" placeholder="العنوان / رقم الغرفة" autocomplete="street-address">
<select id="cy" onchange="$('#pi').hidden=this.value!=='جيب'&&this.value!=='محفظة إلكترونية';$('#pi').textContent=this.value==='جيب'?'حوّل إلى محفظة جيب: ${esc(S.jeeb)}':'المحافظ: ${esc(S.wallet)}'"><option>الدفع عند الاستلام (نقداً)</option><option>جيب</option><option>محفظة إلكترونية</option></select>
<div class="glass" id="pi" hidden style="padding:12px;font-weight:700"></div>
<button class="btn g" onclick="send('wa')">إرسال الطلب عبر واتساب</button><button class="btn b" onclick="send('sms')">إرسال الطلب عبر SMS</button><button class="btn s" onclick="cart={};render()">إفراغ السلة</button></div>`},
contact(){return `<div class="f"><a class="btn" href="tel:773041398">📞 اتصل الآن: 773041398</a><a class="btn g" href="https://wa.me/967773041398" target="_blank" rel="noopener">واتساب</a><div class="glass" style="padding:16px;line-height:1.9">خدمة العملاء متاحة على مدار 24 ساعة طوال أيام الأسبوع للحجوزات والطلبات.</div></div>`},
complaint(){return `<div class="f"><input id="fn" placeholder="الاسم (اختياري)"><textarea id="ft" rows="5" placeholder="اكتب شكواك أو ملاحظتك هنا"></textarea><button class="btn g" onclick="comp()">إرسال عبر واتساب</button></div>`},
about(){return `<div class="glass" style="padding:20px;line-height:2"><div style="text-align:center"><img src="${$('#logo').src}" width="110" style="border-radius:50%" alt=""></div><h3>قصة حرض</h3>نقدّم لضيوفنا تجربة ضيافة تجمع أصالة المطبخ اليمني وراحة الفندق الدولي.<br><b>🧼 نظافة صارمة:</b> معايير تعقيم وسلامة غذاء في المطبخ والغرف.<br><b>🕐 خدمة 24/7:</b> فريقنا جاهز للاستقبال والطلبات في أي وقت.<br><b>التميز .. عنوان</b></div>`},
admin(){if(!adm)return SB.on()?`<div class="f"><input id="em" type="email" placeholder="البريد الإلكتروني للإدارة" autocomplete="username"><input id="pw" type="password" placeholder="كلمة المرور" autocomplete="current-password"><button class="btn" onclick="login()">دخول</button></div>`:`<div class="f"><input id="pw" type="password" placeholder="كلمة مرور الإدارة" inputmode="numeric"><button class="btn" onclick="login()">دخول</button></div>`;
const T=['dishes','rooms','banner','wallet','settings'],N={dishes:'الأطباق',rooms:'الغرف',banner:'البنر',wallet:'المحفظة',settings:'الإعدادات'};
let h=`<div class="chips">${T.map(t=>`<button class="${t==tab?'on':''}" onclick="tab='${t}';ed=null;tmp='';render()">${N[t]}</button>`).join('')}</div>`;
if(tab==='banner'){const b=S.banner;return h+`<div class="f"><textarea id="bt" rows="3">${esc(b.t)}</textarea><input type="file" accept="image/*,video/*" onchange="up(this)"><div id="pv">${b.m?'✅ يوجد ملف حالياً':''}</div><button class="btn" onclick="saveB()">حفظ البنر</button><button class="btn s" onclick="S.banner.m='';save();paint();render()">حذف الوسائط</button></div>`}
if(tab==='settings')return h+`<div class="f"><b>تغيير كلمة المرور</b>${SB.on()?'':`<input id="p0" type="password" placeholder="كلمة المرور الحالية" autocomplete="current-password">`}<input id="p1" type="password" placeholder="كلمة المرور الجديدة (4 أحرف على الأقل)" autocomplete="new-password"><input id="p2" type="password" placeholder="تأكيد كلمة المرور الجديدة" autocomplete="new-password"><button class="btn" onclick="savePw()">حفظ كلمة المرور</button><button class="btn s" onclick="adm=false;render()">تسجيل الخروج</button></div>`;
if(tab==='wallet')return h+`<div class="f"><input id="wj" value="${esc(S.jeeb)}" placeholder="رقم محفظة جيب"><input id="ww" value="${esc(S.wallet)}" placeholder="المحافظ الإلكترونية"><b>أسعار الصرف (مقابل الريال اليمني)</b><input id="rs" type="number" value="${RATE.SAR}" placeholder="1 SAR"><input id="ru" type="number" value="${RATE.USD}" placeholder="1 USD"><button class="btn" onclick="saveW()">حفظ</button></div>`;
const L=S[tab],o=L.find(x=>x.id===ed)||{},dish=tab==='dishes';
return h+`<div class="glass" style="padding:14px;margin-bottom:12px"><b>${ed?'تعديل':'إضافة'}</b><div class="f" style="margin-top:8px"><input id="an" placeholder="الاسم" value="${esc(o.n)}"><input id="ad" placeholder="الوصف" value="${esc(o.d)}"><input id="ap" type="number" placeholder="السعر بالريال اليمني" value="${o.p||''}">${dish?`<select id="ac">${CATS.map((c,i)=>`<option value="${i}" ${o.c==i?'selected':''}>${c}</option>`).join('')}</select>`:''}<input type="file" accept="image/*" onchange="up(this)"><div id="pv">${tmp||o.i?`<img src="${tmp||o.i}" width="60" style="border-radius:10px" alt="">`:''}</div><button class="btn" onclick="saveI()">${ed?'حفظ التعديل':'إضافة'}</button>${ed?'<button class="btn s" onclick="ed=null;tmp=\'\';render()">إلغاء</button>':''}</div></div>
<div style="overflow-x:auto"><table><tr><th></th><th>الاسم</th><th>السعر</th><th></th></tr>${L.map(x=>`<tr><td>${x.i?`<img src="${x.i}" alt="">`:x.e||'🍽️'}</td><td>${esc(x.n)}</td><td>${x.p.toLocaleString('en')}</td><td style="white-space:nowrap"><button class="sm" onclick="ed=${x.id};tmp='';render();$('#sb').scrollTop=0">تعديل</button> <button class="sm r" onclick="del(${x.id})">حذف</button></td></tr>`).join('')}</table></div>`}};
/* cart actions */
function add(id){cart[id]=(cart[id]||0)+1;toast('تمت الإضافة إلى السلة ✓');paint()}
function qty(id,d){cart[id]=(cart[id]||0)+d;if(cart[id]<=0)delete cart[id];render();paint()}
function send(k){const n=$('#cn').value.trim(),p=$('#cp').value.trim(),a=$('#ca').value.trim();if(!n||!p||!a){toast('أكمل الاسم والهاتف والعنوان');return}
let tot=0,l=Object.keys(cart).map(id=>{const d=S.dishes.find(x=>x.id==id);if(!d)return '';tot+=d.p*cart[id];return `• ${d.n} × ${cart[id]} = ${fmt(d.p*cart[id])}`}).join('\n');
const m=`طلب جديد - فندق ومطعم حرض\n${l}\nالإجمالي: ${fmt(tot)}\nالاسم: ${n}\nالهاتف: ${p}\nالعنوان: ${a}\nالدفع: ${$('#cy').value}`;
if(k==='wa')open_('https://wa.me/967773041398?text='+encodeURIComponent(m));else location.href='sms:+967773041398?body='+encodeURIComponent(m)}
function open_(u){window.open(u,'_blank','noopener')}
function comp(){const t=$('#ft').value.trim();if(!t){toast('اكتب ملاحظتك أولاً');return}open_('https://wa.me/967773041398?text='+encodeURIComponent('شكوى/ملاحظة من '+($('#fn').value||'زائر')+':\n'+t))}
/* admin */
function curPw(){return S.pw||'1234567890'}
async function login(){if(!SB.on()){if($('#pw').value===curPw()){adm=true;render()}else toast('كلمة المرور غير صحيحة');return}
try{const r=await fetch(SB.url+'/auth/v1/token?grant_type=password',{method:'POST',headers:{apikey:SB.key,'Content-Type':'application/json'},body:JSON.stringify({email:$('#em').value.trim(),password:$('#pw').value})});const j=await r.json();if(!r.ok||!j.access_token)throw 0;SB.tok=j.access_token;adm=true;const d=await loadRemote();if(!d||!Object.keys(d).length)pushRemote();render()}catch(e){toast('بيانات الدخول غير صحيحة')}}
async function savePw(){const b=$('#p1').value,c=$('#p2').value;if(b.length<6){toast('كلمة المرور الجديدة قصيرة (6 أحرف على الأقل)');return}if(b!==c){toast('تأكيد كلمة المرور غير مطابق');return}
if(SB.on()){try{const r=await fetch(SB.url+'/auth/v1/user',{method:'PUT',headers:SH(SB.tok),body:JSON.stringify({password:b})});if(!r.ok)throw 0;toast('تم تغيير كلمة المرور ✓');render()}catch(e){toast('تعذّر التغيير، سجّل الدخول مرة أخرى')}return}
if($('#p0').value!==curPw()){toast('كلمة المرور الحالية غير صحيحة');return}S.pw=b;save();toast('تم تغيير كلمة المرور ✓');render()}
function up(inp){const f=inp.files[0];if(!f)return;const r=new FileReader();
r.onload=()=>{if(f.type.startsWith('video/')){tmp=r.result;tmp.v=1;up.v=1;$('#pv').textContent='✅ تم اختيار الفيديو';return}up.v=0;
const im=new Image();im.onload=()=>{const k=Math.min(1,720/Math.max(im.width,im.height)),c=document.createElement('canvas');c.width=im.width*k;c.height=im.height*k;c.getContext('2d').drawImage(im,0,0,c.width,c.height);tmp=c.toDataURL('image/jpeg',.78);$('#pv').innerHTML=`<img src="${tmp}" width="60" style="border-radius:10px" alt="">`};im.src=r.result};
r.readAsDataURL(f)}
function saveI(){const L=S[tab],n=$('#an').value.trim(),p=+$('#ap').value;if(!n||!p){toast('الاسم والسعر مطلوبان');return}
let o=L.find(x=>x.id===ed);if(!o){o={id:Date.now()};L.push(o)}Object.assign(o,{n,d:$('#ad').value,p});if(tab==='dishes')o.c=+$('#ac').value;if(tmp)o.i=tmp;
save();ed=null;tmp='';toast('تم الحفظ ✓');render()}
function del(id){if(!confirm('حذف هذا العنصر؟'))return;S[tab]=S[tab].filter(x=>x.id!==id);delete cart[id];save();render()}
function saveB(){S.banner.t=$('#bt').value;if(tmp){S.banner.m=tmp;S.banner.v=up.v?1:0}tmp='';save();paint();toast('تم تحديث البنر ✓')}
function saveW(){S.jeeb=$('#wj').value;S.wallet=$('#ww').value;RATE.SAR=+$('#rs').value||RATE.SAR;RATE.USD=+$('#ru').value||RATE.USD;S.rate={SAR:RATE.SAR,USD:RATE.USD};save();toast('تم الحفظ ✓')}
if(S.rate)Object.assign(RATE,S.rate);
curBar();paint();setTimeout(wink,350);
/* Supabase: public database (everyone reads, only the admin writes) */
const SB={url:'PUT_SUPABASE_URL_HERE',key:'PUT_SUPABASE_ANON_KEY_HERE',tok:null,t:0};
SB.on=()=>SB.url.startsWith('https://');
const SH=a=>({'apikey':SB.key,'Authorization':'Bearer '+(a||SB.key),'Content-Type':'application/json'});
function lsave(){try{localStorage.setItem('harad',JSON.stringify(Object.assign(S,{cur})))}catch(e){}}
function snap(){return {dishes:S.dishes,rooms:S.rooms,banner:S.banner,jeeb:S.jeeb,wallet:S.wallet,rate:{SAR:RATE.SAR,USD:RATE.USD}}}
function applyState(d){if(!d||!Object.keys(d).length)return;['dishes','rooms'].forEach(k=>{if(Array.isArray(d[k]))S[k]=d[k]});if(d.banner)S.banner=d.banner;if(d.jeeb!=null)S.jeeb=d.jeeb;if(d.wallet!=null)S.wallet=d.wallet;if(d.rate){Object.assign(RATE,d.rate);S.rate=Object.assign({},d.rate)}lsave();paint();if(sheet&&!adm)render()}
async function loadRemote(){if(!SB.on())return null;try{const r=await fetch(SB.url+'/rest/v1/site_state?id=eq.1&select=data',{headers:SH()});const j=await r.json();if(j[0]){applyState(j[0].data);return j[0].data}}catch(e){}return null}
function pushRemote(){if(!SB.on()||!SB.tok)return;clearTimeout(SB.t);SB.t=setTimeout(async()=>{try{const r=await fetch(SB.url+'/rest/v1/site_state?id=eq.1',{method:'PATCH',headers:Object.assign(SH(SB.tok),{Prefer:'return=representation'}),body:JSON.stringify({data:snap()})});const j=await r.json();if(!r.ok||!j.length)throw 0;toast('\u062a\u0645 \u0627\u0644\u0646\u0634\u0631 \u0644\u0644\u062c\u0645\u064a\u0639 \u2713')}catch(e){toast('\u062a\u0639\u0630\u0651\u0631 \u0627\u0644\u0646\u0634\u0631\u060c \u0633\u062c\u0651\u0644 \u0627\u0644\u062f\u062e\u0648\u0644 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649')}},500)}
{const o=save;save=function(){o.apply(this,arguments);pushRemote()}}
loadRemote();
</script>
</body>
</html>
